# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# Supabase (new credential format as of 2025)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy variable names (still supported for backward compatibility):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe (for Mentor Payouts only - Clerk Billing handles subscriptions)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: platform fee percent for Stripe Connect (default 10)
# STRIPE_PLATFORM_FEE_PERCENT=10

# AI Services
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-... (optional)
# LANGCHAIN_API_KEY=lsv2_... (optional)
# LANGCHAIN_TRACING_V2=true (optional)
# LANGCHAIN_PROJECT=mentorshape-development (optional)

# Email Service (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@mentorshape.com

# Firecrawl (for LinkedIn scraping and link parsing)
FIRECRAWL_API_KEY=fc-...

# Goal Advisor Integrations (Optional)
# Pipedream (for calendar booking)
PIPEDREAM_WEBHOOK_URL=https://...

# Notion API (for goal export)
NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=... (optional - for specific database)

# Google OAuth (for Google Docs export)
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REDIRECT_URI=...
# GOOGLE_ACCESS_TOKEN=... (for service account, or stored per-user)

# HeroUI Pro (server/gitignored — map to HEROUI_AUTH_TOKEN for CLI installs)
# HEROUI_PRO_PERSONAL_TOKEN=
# HEROUI_AUTH_TOKEN=  # CI/CD or local: used by `heroui-pro install` and npm postinstall

# HeroUI Agents (server-only except public agent id)
HEROUI_AGENT_API_KEY=
HEROUI_AGENT_ID=
NEXT_PUBLIC_HEROUI_AGENT_ID=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Clerk post-auth landing (also set on ClerkProvider in app/layout.tsx)
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/journey
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/journey
